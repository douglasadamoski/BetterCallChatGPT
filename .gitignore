# Runtime state — recreated on first run; never commit (it holds your usage ledger,
# the last session id, and temp prompt files that can name your private projects).
state/*
!state/.gitkeep

# Reports the skill writes into projects it reviews
BETTERCALLCHATGPT_REVIEW_*.md
BETTERCALLCHATGPT_EXPERIMENT_*.md

# Short-lived report temps written next to the report (writability probe + atomic-write temp)
.bcc_wtest.*
.bcc_report.*

# Raw chafa captures / intermediate banner art
*.chafaraw.txt

# Python bytecode cache (py_compile / imports leave these behind)
__pycache__/
*.py[cod]

# OS / editor cruft
.DS_Store
Thumbs.db
*~

# Raw JSON salvaged from an interrupted (already billed) run, if a legacy in-repo state dir exists
orphan-*.jsonl
